  /* Цвет для лейблов и подписей */

  /* ===== GLASS-ЭФФЕКТЫ ===== */
  /* Полупрозрачные фоны и границы для современного glass-morphism дизайна */
  --admin-glass-bg: rgba(255, 255, 255, 0.25);
  /* Основной glass-фон */
  --admin-glass-bg-light: rgba(255, 255, 255, 0.9);
  /* Более непрозрачный glass-фон */
  --admin-glass-border: rgba(255, 255, 255, 0.14);
  /* Границы для glass-элементов */
