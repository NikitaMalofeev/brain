  /* Желтый градиент - для предупреждений */
  --admin-gradient-neutral: linear-gradient(135deg, #F3F3F3 0%, #EAEAEA 100%);
  /* Серый градиент - для отключенных элементов */

  /* ===== ОСНОВНЫЕ ЦВЕТА ===== */
  /* Плоские цвета для обратной совместимости и простых элементов */
