                throw new Error(updateError.message);
            }

            await fetchBlocks(); // Перезагружаем данные
        } catch (err) {
            console.error('Ошибка при обновлении блока:', err);
            throw err;
        }
    };

    const deleteBlock = async (id: number) => {
        try {
            const { error: deleteError } = await supabase
                .from('lesson_blocks')
