            const { data, error: fetchError } = await supabase
                .from('lesson_blocks')
                .select('*')
                .eq('lesson_id', lessonId)
                .order('order_num', { ascending: true });

            if (fetchError) {
                throw new Error(fetchError.message);
            }

            setBlocks(data || []);
