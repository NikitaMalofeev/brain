            {showOnboarding ? (<Onboarding onClose={handleCloseOnboarding} />) : <HashRouter>
                <Routes>
                    {routers.map((router) => <Route key={router.path} {...router} />)}
                    <Route path="*" element={<Navigate to="/" />} />
                </Routes>
            </HashRouter>}
        </AppRoot>
    );
}
