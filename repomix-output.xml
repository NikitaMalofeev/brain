/* ========================================= */
/* CSS-переменные для админки Brain Programming */
/* Светлая тема с glass-эффектами и градиентами */
/* ========================================= */

:root {
  /* ===== ГРАДИЕНТЫ ===== */
  /* Основные градиенты для кнопок, элементов управления и акцентов */
