  /* Основной фиолетовый */
  --admin-primary-hover: #A04FD9;
  /* Фиолетовый при наведении */
  --admin-secondary: #63ABE6;
  /* Вторичный голубой */
  --admin-success: #4EB3FF;
  /* Цвет успеха/одобрения */
  --admin-warning: #FFD166;
  /* Цвет предупреждения */
  --admin-danger: #FF6B6B;
  /* Цвет опасности/ошибки */
  --admin-danger-hover: #FF5252;
  /* Цвет опасности при наведении */
  --admin-info: #63ABE6;
  /* Информационный цвет */

  /* ===== ФОНЫ И ПОВЕРХНОСТИ ===== */
  /* Светлая цветовая схема с использованием чистого белого как основы */
