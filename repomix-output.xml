}

.action-button:active {
  transform: translateY(-1px);
}

.action-button.primary {
  background-color: var(--profile-accent);
  color: white;
  border: none;
}

.action-button.primary:hover {
  background-color: var(--profile-accent-hover);
}

/* Состояние загрузки */
.profile-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  color: var(--profile-text-secondary);
}

.profile-loading-spinner {
  width: 48px;
  height: 48px;
  border: 3px solid rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  border-top-color: var(--profile-accent);
  animation: spin 1s ease-in-out infinite;
  margin-bottom: 1.25rem;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Состояние ошибки */
.profile-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  min-height: 70vh;
}

.profile-error-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.profile-error h2 {
  margin: 0 0 0.5rem;
  color: var(--profile-text-primary);
}

.profile-error p {
  color: var(--profile-text-secondary);
}

/* Медиа-запросы для адаптивности */
@media (max-width: 380px) {
  .profile-main {
    padding: 1rem;
  }
  
  .profile-avatar-container {
    width: 64px;
    height: 64px;
  }
  
  .profile-name {
    font-size: 1.125rem;
  }
  
  .stats-counter {
    font-size: 2.5rem;
  }
}

@media (min-width: 768px) {
  .profile-main {
    max-width: 768px;
    margin: 0 auto;
  }
  
  .profile-stats {
    flex-direction: row;
    flex-wrap: wrap;
  }
  
  .stats-item-large {
    flex: 1;
    min-width: 45%;
  }
}

.ml-2 {
  margin-left: 0.5rem;
}
